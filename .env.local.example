# ============================================================
# 前端构建环境变量模板（Taro 编译期读取，非运行时）
# 复制为项目根目录 .env.local 后填写：
#   Copy-Item .env.local.example .env.local   （Windows）
#   cp .env.local.example .env.local          （Linux/Mac）
#
# ⚠️ 这些值会被编译进前端产物，只能填「公开」信息，
#    任何密钥（AppSecret、service_role key）一律填到 server/.env
# ============================================================

# ===== 【微信小程序必填】后端 API 域名 =======================
# 必须是已备案 + 已配置 HTTPS 证书的域名，不带结尾斜杠、不带 /api
# 例：https://hongbei.example.com
# 用途：小程序端 wx.request 不支持相对路径，需拼接绝对域名
#      （H5 端可留空，走同源 /api 由 Nginx 反代）
TARO_APP_API_BASE=https://your-domain.com

# ===== 【可选】微信小程序 AppID =============================
# 填写后构建会生成 dist/project.config.json 并注入该 AppID，
# 微信开发者工具导入 dist 目录即可直接真机预览，无需手动选 AppID
# 获取：微信公众平台 → 开发管理 → 开发设置 → AppID(小程序ID)
TARO_APP_WEAPP_APPID=

# ===== 【可选】小程序 CI 自动上传 ===========================
# 需先在微信公众平台「开发设置 → 小程序代码上传」生成密钥，
# 保存到项目 key/private.appid.key，并配置 IP 白名单后可用
#   pnpm preview:weapp   # 生成预览二维码
# 填写 TARO_APP_WEAPP_APPID 时会自动启用 plugin-mini-ci
# privateKeyPath 已在 config/index.ts 固定为 key/private.appid.key

# ===== 【可选】抖音小程序（本项目主端为微信，一般留空）======
# TARO_APP_TT_APPID=
# TARO_APP_TT_EMAIL=
# TARO_APP_TT_PASSWORD=

# ===== 【可选】本地开发端口 =================================
# H5 开发服务器端口（默认 5000，代理到 SERVER_PORT）
# PORT=5000
# 后端端口（默认 3000，需与 server/.env 的 SERVER_PORT 一致）
# SERVER_PORT=3000
