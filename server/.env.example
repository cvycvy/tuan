# ============================================================
# 烘焙协助 · 后端环境变量模板
# 复制本文件为 server/.env 后按说明填写：
#   cp .env.example .env        （Linux/宝塔）
#   Copy-Item .env.example .env （Windows）
#
# 读取规则：
#   - 后端只读取 server/.env（dotenv 默认从启动目录加载）
#   - 根目录 .env.local 仅供前端构建使用，后端不读
#   - .env 含密钥，权限设为 600，切勿提交 Git 或放进静态目录
# ============================================================


# ===== 【必填】基础运行配置 ==================================

# 运行环境：production 时会禁用调试登录、JWT 密钥不允许用默认值
# 宝塔 PM2 部署已在 ecosystem.config.cjs 中注入，此处可留空
NODE_ENV=production

# 后端监听端口（Nginx 反代 /api/ → http://127.0.0.1:此端口）
# 防火墙/安全组不要对外开放该端口
SERVER_PORT=3000

# JWT 签名密钥【生产必须改成强随机值】，生成命令：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# 多实例/多机部署时所有实例必须使用同一值，否则登录态互相失效
JWT_SECRET=please-change-me-to-a-random-64char-string
# Token 有效期，支持 1h / 2d / 7d / 30d
JWT_EXPIRES_IN=7d


# ===== 【必填】Supabase 数据库 ===============================
# 获取：https://supabase.com 登录项目 → Settings → API
# 本地开发与生产可共用同一个云项目，无需在服务器安装数据库
COZE_SUPABASE_URL=https://your-project-ref.supabase.co
COZE_SUPABASE_ANON_KEY=eyJhbGciOi-your-anon-public-key
# service_role 密钥绕过 RLS，仅服务端使用，严禁泄露到前端
COZE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi-your-service-role-key


# ===== 【方案1：微信小程序登录】必填 ========================
# 主端为微信小程序时，以下两项【必填】，否则小程序登录直接失败。
# 获取：微信公众平台 → 开发管理 → 开发设置 → AppID / AppSecret
#   WX_APP_ID    小程序 AppID（wx 开头 18 位）
#   WX_APP_SECRET 小程序 AppSecret（重置后 24h 内生效，泄露须立即重置）
# 注意：
#   1. 这里填的是【小程序】的凭证，不是公众号/开放平台的
#   2. 前端还需在项目根目录 .env.local 配置 TARO_APP_API_BASE
#      （小程序 wx.request 不支持相对路径），见 .env.local.example
#   3. jscode2session 不校验来源 IP，服务器无需配置微信侧白名单
WX_APP_ID=
WX_APP_SECRET=

# ===== 【说明】H5 网页端登录 ================================
# 生产模式(NODE_ENV=production)下 /api/auth/dev-login 免密调试登录
# 会被禁用，这是预期行为：H5 端仅作为开发预览/展示页，正式用户
# 走微信小程序。若后续需要 H5 正式登录，另行接入公众号网页授权
# 或手机号验证码登录。


# ===== 【可选】支付配置（购买蛋糕预拌粉）====================
# 总开关：
#   true  = 强制模拟支付（默认演示，不会真实扣款）
#   false = 强制真实支付（渠道凭证没配全会启动报错）
#   留空  = 生产环境凭证齐全走真实渠道，否则自动回退模拟
PAYMENT_MOCK=true

# --- 微信支付（JSAPI / H5 支付，正式收款时填写并取消注释）---
# 商户平台 → 账户中心 → API 安全 获取
# WXPAY_APPID=wx你的公众号或小程序AppID
# WXPAY_MCHID=你的微信支付商户号
# WXPAY_APIV3_KEY=32位APIv3密钥
# WXPAY_SERIAL_NO=商户证书序列号
# 私钥二选一：直接填 PEM 内容，或填服务器上的证书文件路径
# WXPAY_PRIVATE_KEY=
# WXPAY_PRIVATE_KEY_PATH=/www/wwwroot/hongbei/server/cert/apiclient_key.pem
# 支付回调必须为公网 HTTPS 地址，在微信商户平台同步配置：
# WXPAY_NOTIFY_URL=https://你的域名/api/purchase/callback/wechat

# --- 支付宝（手机网站支付，正式收款时填写并取消注释）--------
# 开放平台 → 应用 → 接口加签方式
# ALIPAY_APP_ID=你的支付宝应用APPID
# ALIPAY_APP_PRIVATE_KEY=应用私钥PEM内容
# ALIPAY_PUBLIC_KEY=支付宝公钥PEM内容
# ALIPAY_NOTIFY_URL=https://你的域名/api/purchase/callback/alipay
# 沙箱网关 https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
